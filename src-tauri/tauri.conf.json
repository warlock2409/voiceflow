{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceFlow",
  "version": "0.1.0",
  "identifier": "com.voiceflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -w desktop-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w desktop-ui",
    "frontendDist": "../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local AI voice dictation",
    "resources": ["resources/ggml-silero-v5.1.2.bin"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
